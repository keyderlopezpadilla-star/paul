// Agropaul CMS schema — PostgreSQL (Neon) for production & dev parity.
// `url` is the pooled (PgBouncer) connection used at runtime; `directUrl`
// is the direct (non-pooled) connection used for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  index       String
  title       String
  description String
  bullets     String // JSON-encoded string[] (SQLite has no array type)
  accent      String   @default("forest")
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  duration    String   @default("24 horas")
  badge       String   @default("Certificado Profesional")
  description String
  modules     String // JSON-encoded string[]
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  role      String
  avatar    String? // Cloudinary secure_url or external image URL
  verified  Boolean  @default(true)
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logo      String? // Cloudinary secure_url or external image URL
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String // markdown / long text
  coverColor  String    @default("#0f3d24")
  coverImage  String? // Cloudinary secure_url or external image URL
  category    String    @default("Actualidad")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Inbound leads from the public contact form (Phase 4).
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  interest  String   @default("otro")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Newsletter subscribers captured from the footer form (Phase 4).
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  createdAt DateTime @default(now())
}
