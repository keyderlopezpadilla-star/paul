# ─────────────────────────────────────────────────────────────
# Agropaul — Environment variables
# Copy to .env:  cp .env.example .env
# The defaults below make the CMS work out of the box with SQLite.
# ─────────────────────────────────────────────────────────────

# --- Database ---
# Local dev (zero-config, SQLite):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — swap the provider in prisma/schema.prisma to "postgresql":
# DATABASE_URL="postgresql://user:password@localhost:5432/agropaul"

# --- Auth (NextAuth v5 / Auth.js) ---
# Generate a real secret for production: openssl rand -base64 32
AUTH_SECRET="agropaul-dev-secret-change-me-in-production-0000000000"
NEXTAUTH_URL="http://localhost:3000"

# --- Seeded admin account (created by `npm run db:seed`) ---
ADMIN_EMAIL="admin@agropaul.es"
ADMIN_PASSWORD="agropaul2026"

# --- Public site URL (SEO / canonical / sitemap) ---
NEXT_PUBLIC_SITE_URL="https://agropaul.es"

# --- Transactional email (Resend) — powers the contact & newsletter forms ---
# Without a key, submissions are still stored in the DB (forms work in dev);
# with a key set, notification + confirmation emails are sent.
RESEND_API_KEY=""
# Verified sender. Defaults to Resend's shared "onboarding@resend.dev" sandbox
# address when unset. Use your own verified domain in production.
RESEND_FROM_EMAIL="Agropaul <onboarding@resend.dev>"
# Inbox that receives contact-form notifications.
CONTACT_TO_EMAIL="info@agropaul.es"

# --- Media library (Cloudinary) — powers image uploads in the CMS ---
# Without these, the admin image fields fall back to pasting an image URL.
# Signed direct-to-Cloudinary uploads (the secret never leaves the server).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
